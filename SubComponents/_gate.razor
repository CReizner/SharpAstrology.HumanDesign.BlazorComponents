@using SharpAstrology.Enums
@namespace SharpAstrology.HumanDesign.BlazorComponents

<svg width="100%" height="100%" viewBox="0 0 1 1" @onclick="_click">
    @switch (Activation)
    {
    case ActivationTypes.FirstComparator:
        <circle cx="0.5" cy="0.5" r="0.5"
                fill="@FirstComparerColor"/>
        break;
    case ActivationTypes.SecondComparator:
        <circle cx="0.5" cy="0.5" r="0.5"
                fill="@SecondComparerColor"/>
        break;
    case ActivationTypes.Mixed:
        <svg width="50%" height="100%">
            <circle cx="0.5" cy="0.5" r="0.5"
                    fill="@SecondComparerColor"/>
        </svg>
        <svg x="0.5" width="50%" height="100%">
            <circle cx="0" cy="0.5" r="0.5"
                    fill="@FirstComparerColor"/>
        </svg>
        break;
    }
    <circle cx="0.5" cy="0.5" r="0.5" fill="transparent" class="hoverable-circle"/>

    <text x="0.5" y="0.5" fill="@(Activation == ActivationTypes.None ? "grey" : "white")">
        @Gate.ToNumber()
    </text>
</svg>

@code {

/// <summary>
/// The gate that is drawn. Its number becomes the label of the circle.
/// </summary>
[EditorRequired][Parameter] public Gates Gate { get; set; }

/// <summary>
/// Decides the fill of the circle. A mixed activation is drawn as two half circles.
/// </summary>
[EditorRequired][Parameter] public ActivationTypes Activation { get; set; }

/// <summary>
/// Raised with <see cref="Gate"/> when the circle is clicked.
/// </summary>
[Parameter] public EventCallback<Gates> OnClickCallback { get; set; }

/// <summary>
/// The colour of an activation of the first comparator.
/// </summary>
[Parameter] public string FirstComparerColor { get; set; } = "#000000";

/// <summary>
/// The colour of an activation of the second comparator.
/// </summary>
[Parameter] public string SecondComparerColor { get; set; } = "#ff4081";

private Func<Task>? _clickHandler;

/// <summary>
/// The click handler, built once. There are sixty four gates in a chart, and every one of
/// them would otherwise leave a new delegate behind on every render.
/// </summary>
private Func<Task> _click => _clickHandler ??= () => OnClickCallback.InvokeAsync(Gate);

}
