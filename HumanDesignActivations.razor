@using SharpAstrology.DataModels
@using SharpAstrology.Definitions
@using SharpAstrology.Enums
@using SharpAstrology.BlazorComponents


<div class="activations" style="height: @Height; --activations-color: @Color">
    @foreach (var planet in HumanDesignDefaults.HumanDesignPlanets)
    {
        if (!Activations.TryGetValue(planet, out var activation))
        {
            continue;
        }

        <div @key="planet" class="@(PlanetsRight ? "activation planets-right" : "activation")">

            <p class="gate">@activation.Gate.ToNumber() / @activation.Line.ToNumber()</p>

            <svg class="symbol">
                <PlanetSymbol Planet="planet" Color="@Color"/>
            </svg>

            @if (States is not null && States.TryGetValue(planet, out var state))
            {
                <svg class="state" viewBox="0 0 1 1"
                     style="--state-color: @(state.FixingStateChangedByComparer ? ChangedByComparatorColor : Color)">
                    @switch (state.FixingState)
                    {
                        case FixingState.Detriment:
                            <polygon points="0,0 1,0 0.5,1"/>
                            break;
                        case FixingState.Exalted:
                            <polygon points="0,1 1,1 0.5,0"/>
                            break;
                        case FixingState.Juxtaposed:
                            <line x1="0" x2="1" y1="0.5" y2="0.5"/>
                            <line x1="0.5" x2="0.5" y1="0" y2="1"/>
                            <line x1="0.2" x2="0.8" y1="0.2" y2="0.8"/>
                            <line x1="0.8" x2="0.2" y1="0.2" y2="0.8"/>
                            break;
                        default:
                            break;
                    }
                </svg>
            }
        </div>
    }
</div>

@code {

    /// <summary>
    /// The activations to list, one row per planet. Planets that are missing are skipped.
    /// </summary>
    [EditorRequired][Parameter] public Dictionary<Planets, Activation> Activations { get; set; } = null!;

    /// <summary>
    /// The fixing states of the planets. Without them no state marker is drawn.
    /// </summary>
    [Parameter] public Dictionary<Planets, PlanetaryFixation>? States { get; set; }

    /// <summary>
    /// Puts the planet symbol on the right hand side of a row. Useful for the second of two
    /// lists, so that both point towards the chart between them.
    /// </summary>
    [Parameter] public bool PlanetsRight { get; set; } = false;

    /// <summary>
    /// The colour of the gate numbers, the planet symbols and the state markers.
    /// </summary>
    [Parameter] public string Color { get; set; } = "#000000";

    /// <summary>
    /// The colour of a state marker whose state the comparator changed.
    /// </summary>
    [Parameter] public string ChangedByComparatorColor { get; set; } = "#000000";

    /// <summary>
    /// The height of the list. The rows share it in equal parts.
    /// </summary>
    [Parameter] public string Height { get; set; } = "100%";

}
