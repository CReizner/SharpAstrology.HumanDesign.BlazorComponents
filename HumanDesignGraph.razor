@using SharpAstrology.Enums
@using SharpAstrology.DataModels


<svg x="0" y="0" viewBox="0 0 1 1.5" width="@Width" height="@Height">

    <!-- Curved Channels -->
    @foreach (var channel in CurvedChannels)
    {
        foreach (var (color, dash) in _strokes(Chart.GateActivations[channel.Gate1]))
        {
            <path d="@channel.FirstHalf"
                  fill="none"
                  stroke="@color"
                  stroke-width="0.02"
                  stroke-dasharray="@dash"
                  pointer-events="none"/>
        }
        foreach (var (color, dash) in _strokes(Chart.GateActivations[channel.Gate2]))
        {
            <path d="@channel.SecondHalf"
                  fill="none"
                  stroke="@color"
                  stroke-width="0.02"
                  stroke-dasharray="@dash"
                  pointer-events="none"/>
        }
        <path @key="channel.Channel" d="@channel.Whole"
              fill="none"
              class="channel"
              stroke="transparent"
              @onclick="_channelClick(channel.Channel)"/>
    }

    <!-- Line Channels -->
    @foreach (var channel in StraightChannels)
    {
        foreach (var (color, dash) in _strokes(Chart.GateActivations[channel.Gate1]))
        {
            <line x1="@channel.From.XText" y1="@channel.From.YText"
                  x2="@channel.Middle.XText" y2="@channel.Middle.YText"
                  stroke="@color"
                  stroke-width="0.02"
                  stroke-dasharray="@dash"
                  pointer-events="none"/>
        }
        foreach (var (color, dash) in _strokes(Chart.GateActivations[channel.Gate2]))
        {
            <line x1="@channel.Middle.XText" y1="@channel.Middle.YText"
                  x2="@channel.To.XText" y2="@channel.To.YText"
                  stroke="@color"
                  stroke-width="0.02"
                  stroke-dasharray="@dash"
                  pointer-events="none"/>
        }
        <line @key="channel.Channel"
              x1="@channel.From.XText" y1="@channel.From.YText"
              x2="@channel.To.XText" y2="@channel.To.YText"
              class="channel"
              stroke="transparent"
              @onclick="_channelClick(channel.Channel)"/>
    }

    <!-- Centers with their gates -->
    @foreach (var center in CenterLayouts)
    {
        <svg @key="center.Center" id="@_centerId(center)" data-center="@center.Name"
             x="@center.Position.XText" y="@center.Position.YText"
             width="@center.Size.WidthText" height="@center.Size.HeightText"
             viewBox="@center.ViewBoxText"
             style="@center.Style">

            @if (center.Outline is null)
            {
                <rect x="0" y="0" rx="0.1" ry="0.1" width="1" height="1" class="center"
                      @onclick="_centerClick(center.Center)"
                      fill="@_centerFill(center.Center)"/>
            }
            else
            {
                <polygon points="@center.Outline" class="center"
                         @onclick="_centerClick(center.Center)"
                         fill="@_centerFill(center.Center)"/>
            }

            @foreach (var gate in center.Gates)
            {
                <svg @key="gate.Gate" id="@_gateId(gate)" data-gate="@gate.NumberText"
                     x="@gate.Position.XText" y="@gate.Position.YText"
                     width="@center.GateSize.WidthText" height="@center.GateSize.HeightText"
                     viewBox="0 0 1 1">
                    <_gate Gate="gate.Gate"
                           Activation="Chart.GateActivations[gate.Gate]"
                           OnClickCallback="OnGateClick"
                           FirstComparerColor="@FirstComparerColor"
                           SecondComparerColor="@SecondComparerColor"/>
                </svg>
            }
        </svg>
    }
</svg>


@code {

      /// <summary>
      /// The chart that is drawn. Without it the component cannot render.
      /// </summary>
      [EditorRequired][Parameter] public HumanDesignChart Chart { get; set; } = null!;

      /// <summary>
      /// The width of the chart. Goes into the width attribute of the outer svg element.
      /// </summary>
      [Parameter] public string Width { get; set; } = "auto";

      /// <summary>
      /// The height of the chart. Goes into the height attribute of the outer svg element.
      /// </summary>
      [Parameter] public string Height { get; set; } = "100%";

      /// <summary>
      /// Raised with the gate that was clicked.
      /// </summary>
      [Parameter] public EventCallback<Gates> OnGateClick { get; set; }

      /// <summary>
      /// Raised with the channel that was clicked. The whole channel is one target,
      /// both halves belong to it.
      /// </summary>
      [Parameter] public EventCallback<Channels> OnChannelClick { get; set; }

      /// <summary>
      /// Raised with the center that was clicked.
      /// </summary>
      [Parameter] public EventCallback<Centers> OnCenterClick { get; set; }

      /// <summary>
      /// The colour of everything the first comparator activates. In a single chart that is
      /// the personality side.
      /// </summary>
      [Parameter] public string FirstComparerColor { get; set; } = "#000000";

      /// <summary>
      /// The colour of everything the second comparator activates. In a single chart that is
      /// the design side.
      /// </summary>
      [Parameter] public string SecondComparerColor { get; set; } = "#ff4081";

      /// <summary>
      /// The colour of a channel half that no comparator activates.
      /// </summary>
      [Parameter] public string InactiveChannelColor { get; set; } = "lightgrey";

      /// <summary>
      /// The fill of a center that is not defined.
      /// </summary>
      [Parameter] public string UndefinedCenterColor { get; set; } = "white";

      /// <summary>
      /// The fill of every defined center. A map that leaves centers out is allowed. The
      /// missing ones fall back to <see cref="DefaultCenterColorMap"/>.
      /// </summary>
      [Parameter] public IReadOnlyDictionary<Centers, string> CenterColorMap { get; set; } = DefaultCenterColorMap;

      /// <summary>
      /// Written in front of the id attribute of every center and every gate. As long as it is
      /// empty, no id attribute is written at all, and two charts can share one page without
      /// producing the same id twice. Centers and gates always carry a data-center and a
      /// data-gate attribute, which may repeat.
      /// </summary>
      [Parameter] public string IdPrefix { get; set; } = "";

      /// <summary>
      /// The colours a defined center is filled with, if <see cref="CenterColorMap"/> says
      /// nothing about it.
      /// </summary>
      public static IReadOnlyDictionary<Centers, string> DefaultCenterColorMap { get; } = new Dictionary<Centers, string>
      {
            [Centers.Root] = "#E88835",
            [Centers.Sacral] = "#FE352C",
            [Centers.Emotions] = "#E88835",
            [Centers.Spleen] = "#E88835",
            [Centers.Heart] = "#FE352C",
            [Centers.Self] = "#FFD12B",
            [Centers.Throat] = "#E88835",
            [Centers.Mind] = "#87FE49",
            [Centers.Crown] = "#FFD12B"
      };

      /// <summary>
      /// The dash pattern of the second stroke of a mixed activation.
      /// </summary>
      private const string MixedDashArray = "0.01,0.01";

      private (string Color, string? Dash)[] _inactiveStrokes = [];
      private (string Color, string? Dash)[] _firstStrokes = [];
      private (string Color, string? Dash)[] _secondStrokes = [];
      private (string Color, string? Dash)[] _mixedStrokes = [];

      private readonly Dictionary<Centers, Func<Task>> _centerClicks = new();
      private readonly Dictionary<Channels, Func<Task>> _channelClicks = new();

      protected override void OnParametersSet()
      {
            _inactiveStrokes = [(InactiveChannelColor, null)];
            _firstStrokes = [(FirstComparerColor, null)];
            _secondStrokes = [(SecondComparerColor, null)];
            _mixedStrokes = [(FirstComparerColor, null), (SecondComparerColor, MixedDashArray)];
      }

      /// <summary>
      /// The strokes that make up one half of a channel. The first entry is the solid base
      /// stroke. A mixed activation puts a dashed stroke of the second colour on top of it.
      /// </summary>
      private (string Color, string? Dash)[] _strokes(ActivationTypes activation) => activation switch
      {
            ActivationTypes.FirstComparator => _firstStrokes,
            ActivationTypes.SecondComparator => _secondStrokes,
            ActivationTypes.Mixed => _mixedStrokes,
            _ => _inactiveStrokes
      };

      /// <summary>
      /// The fill of a center. An undefined center gets <see cref="UndefinedCenterColor"/>,
      /// a center the map does not mention falls back to the default map.
      /// </summary>
      private string _centerFill(Centers center)
      {
            if (!Chart.ConnectedComponents.ContainsKey(center)) return UndefinedCenterColor;
            return CenterColorMap.TryGetValue(center, out var color) ? color : DefaultCenterColorMap[center];
      }

      private string? _centerId(CenterLayout center)
            => IdPrefix.Length == 0 ? null : $"{IdPrefix}center-{center.Name}";

      private string? _gateId(GateLayout gate)
            => IdPrefix.Length == 0 ? null : $"{IdPrefix}gate-{gate.NumberText}";

      /// <summary>
      /// The click handler of a center. The handlers are kept, so that a render pass does not
      /// build a new delegate for every element.
      /// </summary>
      private Func<Task> _centerClick(Centers center)
      {
            if (_centerClicks.TryGetValue(center, out var handler)) return handler;
            handler = () => OnCenterClick.InvokeAsync(center);
            _centerClicks[center] = handler;
            return handler;
      }

      /// <summary>
      /// The click handler of a channel, kept for the same reason as the one of a center.
      /// </summary>
      private Func<Task> _channelClick(Channels channel)
      {
            if (_channelClicks.TryGetValue(channel, out var handler)) return handler;
            handler = () => OnChannelClick.InvokeAsync(channel);
            _channelClicks[channel] = handler;
            return handler;
      }

}
